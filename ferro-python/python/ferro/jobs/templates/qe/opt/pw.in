! ferro-py template: Quantum ESPRESSO pw.x geometry optimisation, PBE-D3(BJ)
!
! ferro-py writes ATOMIC_SPECIES / CELL_PARAMETERS / ATOMIC_POSITIONS from the structure
! and sets nat, ntyp, pseudo_dir ([qe] pseudo_dir of the configuration), tot_charge,
! nspin + tot_magnetization (when the multiplicity is above 1; tot_magnetization = 0
! when --multiplicity 1 is given and nspin = 2 is written here) and K_POINTS
! (--kspacing; a K_POINTS card written here is kept when --kspacing is not given).
! ecutwfc / ecutrho: when not written here, the largest suggestion in the UPF headers.
! --vary-cell sets calculation = 'vc-relax' and adds &CELL (bfgs, press_conv_thr 0.5 kbar)
! when none is written here. Everything else is used as written. The functional comes
! from the UPF files.
! Comments inside the namelists are not carried into the generated pw.in.
!
! Not set here on purpose: parallelisation -- pw.x takes it from the command line
! (mpirun -np N pw.x -nk POOLS -nd DIAG); add your machine's.
&CONTROL
  calculation = 'relax'
  restart_mode = 'from_scratch'
  prefix = 'pw'
  outdir = './tmp/'
  tstress = .true.
  tprnfor = .true.
  verbosity = 'high'
  disk_io = 'low'
  nstep = 200
  etot_conv_thr = 1e-4
  forc_conv_thr = 1e-3
/
&SYSTEM
  ibrav = 0
  vdw_corr = 'dft-d3'
  dftd3_version = 4
/
&ELECTRONS
  electron_maxstep = 200
  diagonalization = 'david'
  conv_thr = 1e-10
  diago_thr_init = 1e-4
/
&IONS
  ion_dynamics = 'bfgs'
/
