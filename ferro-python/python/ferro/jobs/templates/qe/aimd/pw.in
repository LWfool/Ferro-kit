! ferro-py template: Quantum ESPRESSO pw.x AIMD (NVT, SVR thermostat), PBE-D3(BJ)
!
! ferro-py writes ATOMIC_SPECIES / CELL_PARAMETERS / ATOMIC_POSITIONS from the structure
! and sets nat, ntyp, pseudo_dir ([qe] pseudo_dir of the configuration), tot_charge,
! nspin + tot_magnetization (when the multiplicity is above 1) and K_POINTS
! (--kspacing; a K_POINTS card written here is kept when --kspacing is not given).
! ecutwfc / ecutrho: when not written here, the largest suggestion in the UPF headers.
! --temperature sets tempw, --steps nstep, --timestep dt (converted from fs to Rydberg
! atomic units, 1 fs = 20.67). NpT is not offered for QE (vc-md has no thermostat).
! Everything else is used as written. The functional comes from the UPF files.
! Comments inside the namelists are not carried into the generated pw.in.
&CONTROL
  calculation = 'md'
  restart_mode = 'from_scratch'
  prefix = 'pw'
  outdir = './tmp/'
  tstress = .true.
  nstep = 2000
  dt = 20.67  ! Rydberg a.u. (1 fs)
  tprnfor = .true.
  verbosity = 'high'
  disk_io = 'low'
/
&SYSTEM
  ibrav = 0
  vdw_corr = 'dft-d3'
  dftd3_version = 4
  nosym = .true.  ! thermostat velocities break the initial symmetry (checkallsym aborts)
/
&ELECTRONS
  electron_maxstep = 200
  diagonalization = 'david'
  conv_thr = 1e-8
  diago_thr_init = 1e-4
/
&IONS
  ion_dynamics = 'verlet'
  ion_temperature = 'svr'
  tempw = 300  ! K
  nraise = 150  ! time constant in steps (150 fs at 1 fs)
/
